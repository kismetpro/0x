# Docker 部署配置（复制为 .env）
# 本仓库发布的镜像地址（GHCR，公开仓库的镜像无需登录即可拉取）；
# 若维护者额外配了 Docker Hub，也可改成 kismetpro/0x。
ZEROX_IMAGE=ghcr.io/kismetpro/0x
ZEROX_TAG=latest
# 独立的数据库角色/库名，避免与原版 ARTEX 共用同一个 Postgres 实例时撞车。
POSTGRES_USER=zerox
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=zerox

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ZEROX_LLM_PROVIDER=
ZEROX_LLM_MODEL=
ZEROX_LLM_BASE_URL=
ZEROX_LLM_PROXY=
ZEROX_LLM_THINKING_TYPE=
ZEROX_LLM_REASONING_EFFORT=
